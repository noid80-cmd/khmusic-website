generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== 사용자 관리 ====================

// 관리자 계정
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // hashed password
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== 강사 관리 ====================

// 전공 분야
model Subject {
  id          String       @id @default(cuid())
  name        String       @unique  // Vocal, Piano, Guitar 등
  nameKo      String       // 보컬, 피아노, 기타 등
  description String?      // 대중음악 보컬 전문 교육 등
  features    String?      @db.Text // 특징 (JSON array: ["발성법", "호흡법", ...])
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  instructors InstructorSubject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// 강사
model Instructor {
  id                String   @id @default(cuid())
  name              String
  image             String?  // 프로필 이미지 URL
  intro             String?  @db.Text // 자기소개
  profile           String?  @db.Text // 프로필
  curriculum        String?  @db.Text // 커리큘럼
  musicGenres       String?  @db.Text // 추구하는 음악장르
  recommendedAlbums String?  @db.Text // 추천음반리스트
  messageToStudents String?  @db.Text // 레슨생분들께 드리는 말씀
  videoUrl1         String?  // 영상 URL 1 (YouTube)
  videoUrl2         String?  // 영상 URL 2 (YouTube)
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  mainPageOrder     Int?     // 메인페이지 노출 순서 (null이면 메인에 노출 안함)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subjects          InstructorSubject[]
}

// 강사-전공 다대다 관계 (중간 테이블)
model InstructorSubject {
  id           String     @id @default(cuid())
  instructorId String
  subjectId    String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  order        Int        @default(0) // 해당 전공 내 순서
  createdAt    DateTime   @default(now())

  @@unique([instructorId, subjectId])
  @@index([instructorId])
  @@index([subjectId])
}

// ==================== 공지사항 ====================

model Notice {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  category    NoticeCategory @default(GENERAL)
  isPinned    Boolean      @default(false)
  viewCount   Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum NoticeCategory {
  GENERAL      // 일반 공지
  ADMISSION    // 입시 관련
  EVENT        // 이벤트
  INSTRUCTOR   // 강사 소식
}

// ==================== 합격자 명단 ====================

model Admission {
  id           String   @id @default(cuid())
  studentName  String   // 학생 이름 (익명처리 가능: 김OO)
  university   String   // 합격 대학
  department   String   // 학과
  year         Int      // 합격 연도
  major        String?  // 전공 (보컬, 피아노 등)
  // university 한 칸에 학교명·수시정시·합격단계가 섞여 있어 집계가 불가능했다.
  // 학교명만 university에 남기고 나머지를 아래 두 컬럼으로 분리한다.
  // 화면 표기는 university + stage를 다시 합쳐 보여주므로 보이는 내용은 그대로다.
  stage        String?  // 1차합격 / 1단계합격 / 예비3 / 수석 등. null이면 최종합격
  admissionType String? // 수시 / 정시. 원본에 표기가 있던 건만 채운다(대부분 불명)
  isEarlyAdmission Boolean @default(false) // 수시/정시 구분 (기존 필드, 신뢰도 낮음)
  photoUrl     String?  // 합격 인증 사진
  testimonial  String?  @db.Text // 합격 후기
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year])
}

// ==================== 배출 뮤지션 ====================

model Musician {
  id          String   @id @default(cuid())
  name        String
  role        String   // 싱어송라이터, 프로듀서 등
  achievement String?  // 주요 활동/성과
  image       String?
  snsUrl      String?  // SNS 링크
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== 상담 신청 ====================

model Consultation {
  id          String            @id @default(cuid())
  name        String
  phone       String
  email       String?
  age         String?           // 나이대
  gender      Gender?
  subject     String?           // 관심 전공
  purpose     ConsultationPurpose?
  message     String?           @db.Text
  status      ConsultationStatus @default(PENDING)
  memo        String?           @db.Text  // 관리자 메모
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

enum ConsultationPurpose {
  ADMISSION    // 입시
  AUDITION     // 오디션
  PROFESSIONAL // 전문반
  HOBBY        // 취미
  OTHER        // 기타
}

enum ConsultationStatus {
  PENDING      // 대기중
  CONTACTED    // 연락완료
  SCHEDULED    // 상담예약
  COMPLETED    // 상담완료
  CANCELLED    // 취소
}

// ==================== 시설/공연 사진 갤러리 ====================

model GalleryImage {
  id          String        @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  category    GalleryCategory
  order       Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum GalleryCategory {
  FACILITY     // 시설 사진
  PERFORMANCE  // 공연 사진
  EVENT        // 이벤트 사진
}

// ==================== 영상 관리 ====================

model Video {
  id          String        @id @default(cuid())
  title       String
  description String?
  youtubeUrl  String        // YouTube URL
  thumbnailUrl String?
  category    VideoCategory
  isPublished Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum VideoCategory {
  ADMISSION_SUCCESS  // 합격 영상
  TRAINEE           // 수강생 영상
  MUSICIAN_LECTURE  // 뮤지션 특강
  PERFORMANCE       // 공연 영상
}

// ==================== 입시요강 ====================

model AdmissionGuide {
  id            String              @id @default(cuid())
  university    String              // 대학명
  department    String?             // 학과
  category      AdmissionGuideCategory
  year          Int                 // 입시 연도
  content       String              @db.Text  // 요강 내용
  deadline      String?             // 지원 마감일
  examDate      String?             // 시험 일정
  requirements  String?             @db.Text  // 지원 자격
  documents     String?             @db.Text  // 제출 서류
  examContent   String?             @db.Text  // 실기 내용
  link          String?             // 대학 원서 링크
  isPublished   Boolean             @default(true)
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([year])
  @@index([category])
}

enum AdmissionGuideCategory {
  UNIVERSITY_4YR   // 4년제 대학
  UNIVERSITY_2YR   // 전문대학
  ART_HIGHSCHOOL   // 예술고등학교
  GRADUATE         // 대학원
}

// ==================== 히어로 슬라이드 ====================

model HeroSlide {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String
  buttonText   String?
  buttonLink   String?
  textPosition String   @default("left") // left, center, right
  textAlign    String   @default("left") // left, center, right
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==================== 사이트 설정 ====================

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

// ==================== 특별 프로그램 관리 ====================

model Program {
  id          String   @id @default(cuid())
  slug        String   @unique // ht, cake-concert, open-stage, album, audition
  name        String   // HT 프로그램, 케이크콘서트 등
  subtitle    String?  // Harmony Training, Cake Concert 등
  description String?  @db.Text // 프로그램 설명
  icon        String?  // 아이콘 (SVG 또는 이미지 URL)
  image       String?  // 대표 이미지 URL
  content     String?  @db.Text // 상세 페이지 내용 (JSON)
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== 커리큘럼 관리 ====================

// 커리큘럼 반 (입시반, 오디션반, 전문반, 취미반)
model CurriculumClass {
  id          String   @id @default(cuid())
  slug        String   @unique // admission, audition, professional, hobby
  title       String   // 입시반, 오디션반, 전문반, 취미반
  subtitle    String?  // 부제목
  intro       String?  @db.Text // 소개 텍스트
  bgImage     String?  // 배경 이미지 URL
  benefits    String?  @db.Text // 혜택 (JSON array)
  universities String? @db.Text // 대학교 목록 (JSON array) - 입시반용
  agencies    String?  @db.Text // 기획사 목록 (JSON array) - 오디션반용
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  majors      CurriculumMajor[]
}

// 커리큘럼 전공 (보컬, 작곡, 미디, 피아노 등)
model CurriculumMajor {
  id          String   @id @default(cuid())
  classId     String
  class       CurriculumClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String   // 보컬, 작곡, 미디 등
  icon        String?  // 아이콘 URL
  description String?  @db.Text // 설명
  curriculum  String?  @db.Text // 커리큘럼 트리 (JSON)
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
}

// ==================== 블로그 ====================
// 입시요강·합격자 데이터를 근거로 쓰는 글. 네이버 검색 노출이 목적이라
// 목록/상세 페이지는 클라이언트 렌더링이 아닌 서버 렌더링으로 만든다.

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique  // URL. 영문+숫자+하이픈
  title       String
  excerpt     String       @db.Text // 목록 요약 겸 meta description
  content     String       @db.Text // 본문 HTML
  coverImage  String?
  category    BlogCategory @default(ADMISSION)
  keywords    String?               // 쉼표로 구분
  sourceNote  String?               // 어떤 데이터를 근거로 썼는지 (글 하단 출처 표기)
  naverDraft  String?      @db.Text // 네이버 블로그에 붙여넣을 버전
  isAutoDraft Boolean      @default(false) // 자동 생성분인지
  factCheck   String?      @db.Text // 자동 대조에서 근거를 못 찾은 날짜·비율·인원. 비어 있으면 통과
  sourceLink  String?               // 대조 기준이 된 대학 공식 요강 링크
  status      BlogStatus   @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

enum BlogCategory {
  ADMISSION  // 입시 정보 — 요강 분석, 합격 데이터
  PRACTICE   // 연습·실기 — 준비 방법
  ACADEMY    // 학원 이야기 — 공연, 소식
}

enum BlogStatus {
  DRAFT      // 초안. 자동 생성분은 여기서 시작한다
  PUBLISHED  // 게시됨
}
